@@ -0,0 +1,102 @@
+"""Structured generation failures shared by the Ming model and HTTP service."""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Any, Sequence, TypeVar
+
+
+T = TypeVar("T")
+DEFAULT_CAPPED_MAX_TOTAL_STEPS = 1024
+
+
+class NoAudioTokensError(RuntimeError):
+    """The language model finished without entering a usable audio turn."""
+
+    error_code = "no_audio_tokens"
+
+    def __init__(self, diagnostics: dict[str, Any]):
+        self.diagnostics = dict(diagnostics)
+        super().__init__("Ming-UniAudio generated no audio latent tokens")
+
+
+@dataclass(frozen=True)
+class EditGenerationBudget:
+    """Independent total-generation and audio-generation limits."""
+
+    legacy_max_steps: int
+    max_audio_steps: int | None
+    max_total_steps: int
+
+    def stop_reason(
+        self,
+        *,
+        generated_steps: int,
+        audio_steps: int,
+    ) -> str | None:
+        if (
+            self.max_audio_steps is not None
+            and audio_steps >= self.max_audio_steps
+        ):
+            return "max_audio_seconds"
+        if generated_steps >= self.max_total_steps:
+            return "max_total_steps"
+        return None
+
+
+def require_audio_latents(
+    latents: Sequence[T],
+    *,
+    diagnostics: dict[str, Any],
+) -> Sequence[T]:
+    """Return non-empty latents or raise a structured model-generation error."""
+
+    if not latents:
+        raise NoAudioTokensError(diagnostics)
+    return latents
+
+
+def resolve_max_audio_steps(
+    max_audio_seconds: float | None,
+    *,
+    sample_rate: int,
+    patch_size: int,
+    hop_length: int,
+) -> int | None:
+    """Convert a wall-clock audio cap to the model's latent patch steps."""
+
+    if max_audio_seconds is None:
+        return None
+    return max(
+        1,
+        math.ceil(
+            float(max_audio_seconds) * sample_rate / (patch_size * hop_length)
+        ),
+    )
+
+
+def resolve_edit_generation_budget(
+    *,
+    input_token_count: int,
+    max_audio_steps: int | None,
+    capped_max_total_steps: int = DEFAULT_CAPPED_MAX_TOTAL_STEPS,
+) -> EditGenerationBudget:
+    """Resolve a bounded edit budget without changing uncapped decoding.
+
+    Upstream decoding historically allows ``max(input_tokens * 2.5, 100)``
+    total steps. An explicit audio-duration cap needs that text/CoT allowance
+    plus an independent safety guard; otherwise a long CoT can consume the
+    entire loop before audio generation starts. The audio-duration limit is
+    tracked separately and does not determine this guard.
+    """
+
+    legacy_max_steps = max(int(input_token_count * 2.5), 100)
+    max_total_steps = legacy_max_steps
+    if max_audio_steps is not None:
+        max_total_steps = max(legacy_max_steps, capped_max_total_steps)
+    return EditGenerationBudget(
+        legacy_max_steps=legacy_max_steps,
+        max_audio_steps=max_audio_steps,
+        max_total_steps=max_total_steps,
+    )
